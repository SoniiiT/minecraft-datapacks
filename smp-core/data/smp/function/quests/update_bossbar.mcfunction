# === Bossbar-Fortschritt aktualisieren ===
# Wird als @s ausgeführt. Aktualisiert den Spieler-Slot-Bossbar.

execute if score @s smp.slot matches 1 run bossbar set smp:q1 players @s
execute if score @s smp.slot matches 1 store result bossbar smp:q1 value run scoreboard players get @s smp.quest.progress
execute if score @s smp.slot matches 1 store result bossbar smp:q1 max   run scoreboard players get @s smp.quest.target
execute if score @s smp.slot matches 1 run bossbar set smp:q1 visible true
